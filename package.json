{
  "name": "dwcompanion",
  "version": "0.3.3",
  "description": "Dragneel's Warframe Companion",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "data": "node scripts/fetch-wiki-farming.mjs && node scripts/fetch-wiki-abilities.mjs && node scripts/build-drops.mjs && node scripts/build-data.mjs && node scripts/build-frames.mjs && node scripts/build-gear.mjs && node scripts/build-mastery.mjs && node scripts/build-rivens.mjs && node scripts/build-weekly.mjs",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-http": "~2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@wfcd/items": "^1.1276.50",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "warframe-public-export-plus": "^0.6.12"
  }
}
