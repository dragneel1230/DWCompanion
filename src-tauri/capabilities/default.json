{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.warframe.market/*"
        },
        {
          "url": "https://api.warframe.com/cdn/*"
        }
      ]
    },
    "clipboard-manager:allow-write-text"
  ]
}