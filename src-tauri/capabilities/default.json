{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, the reward overlay and the hub",
  "windows": [
    "main",
    "overlay",
    "hub"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.warframe.market/*"
        },
        {
          "url": "https://api.warframe.com/cdn/*"
        },
        {
          "url": "https://api.warframestat.us/*"
        },
        {
          "url": "https://relics.run/history/*"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
