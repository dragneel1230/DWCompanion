{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DWCompanion",
  "version": "0.1.0",
  "identifier": "com.dragneel.dwcompanion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DWCompanion",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Dragneel",
    "shortDescription": "Dragneel's Warframe Companion",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MjRBRkI4NDlBMTcwMUYKUldRZmNLRkp1SzhrNXpPUk5RYnRNSGU5M3pzTHplQUFuUDNVaUdCeXZ1NHNkaFBYVVI1SWYvbFMK",
      "endpoints": [
        "https://github.com/dragneel1230/DWCompanion-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
